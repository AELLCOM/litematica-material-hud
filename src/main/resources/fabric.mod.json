{
	"schemaVersion": 1,
	"id": "layerlist",
	"version": "${version}",
	"name": "Litematica Material HUD",
	"description": "Shows the Litematica material list for the current layer as a HUD and marks the chests, barrels and shulker boxes that hold the needed blocks. Includes the Ghost Alpha and Easy Place modules.",
	"authors": [
		"Aell_"
	],
	"contact": {
		"discord": "https://discord.gg/jTU2yawThv"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/layerlist/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.aell.layerlist.LayerListClient"
		],
		"modmenu": [
			"com.aell.layerlist.compat.ModMenuImpl"
		]
	},
	"mixins": [
		{
			"config": "layerlist.mixins.json",
			"environment": "client"
		},
		{
			"config": "layerlist.voxy.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"malilib": "*",
		"litematica": "*"
	}
}
